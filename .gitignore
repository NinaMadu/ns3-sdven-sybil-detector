# Track only the simulation source, configs, helper scripts, and input data.
# Generated results, plots, logs, and ns-3 build artifacts stay out of Git.

# Ignore everything by default.
*

# Repository metadata and top-level docs.
!.gitignore
!/README.md

# Main ns-3 simulation source.
!scratch/
!scratch/Sybil-Developing-Improved.cc
!scratch/sybil_attacks.h
!scratch/sybil_crypto.h
!scratch/sybil_metrics.h
!scratch/sybil_types.h
!scratch/rssi_sybil_detection.h
!scratch/fl_sybil_detection.h

# Project folder and tracked runtime inputs.
!sybil-attack/
!sybil-attack/configs/
!sybil-attack/configs/**
!sybil-attack/inputs/
!sybil-attack/security/
!sybil-attack/security/**
!sybil-attack/scripts/
!sybil-attack/scripts/**
!sybil-attack/commands/
!sybil-attack/commands/**
!sybil-attack/notebooks/
!sybil-attack/notebooks/**
.ipynb_checkpoints/
!sybil-attack/mobility_routing_test_report.md
!sybil-attack/fl/
!sybil-attack/fl/scripts/
!sybil-attack/fl/scripts/**

# Keep runtime CSVs loaded directly by the simulation.
!sybil-attack/inputs/*.csv

# Never track generated simulation outputs/results.
sybil-attack/outputs/
sybil-attack/outputs/**
sybil-attack/**/outputs/
sybil-attack/**/outputs/**
sybil-attack/**/evaluation_runs/
sybil-attack/**/evaluation_runs/**
sybil-attack/**/visualizations/
sybil-attack/**/visualizations/**

# Common generated result/report artifacts.
*.csv.tmp
*.log
*.pcap
*.pcapng
*.tr
*.dat
*.plt
*.png
*.svg
*.pptx
*.pdf

# Generated XML is ignored by default; mobility scenario XML/TCL/SUMO files are
# explicitly allowed below.
*.xml
*.tcl
*.netccfg
*.sumocfg

# Mobility scenario assets required to reproduce SUMO/ns-2 mobility setup.
!sybil-attack/inputs/mobility/
!sybil-attack/inputs/mobility/**/
!sybil-attack/inputs/mobility/**/*.csv
!sybil-attack/inputs/mobility/**/*.xml
!sybil-attack/inputs/mobility/**/*.tcl
!sybil-attack/inputs/mobility/**/*.netccfg
!sybil-attack/inputs/mobility/**/*.sumocfg

# ns-3/build artifacts and local tooling.
build/
cmake-cache/
__pycache__/
.pytest_cache/
.cache/
.venv/
.vscode/
.waf*
.lock-waf*

# OS/editor/download noise.
*~
*.swp
*.swo
.DS_Store
Thumbs.db

!rssi_mcc_sweep.py
*.Zone.Identifier

# ── Reorganized ML/LLM tree (sybil-attack/ml): version-control the SOURCE, not
#    the trained weights, datasets, or generated outputs. ──
!sybil-attack/ml/
!sybil-attack/ml/**/
!sybil-attack/ml/**/*.py
!sybil-attack/ml/**/*.ipynb
!sybil-attack/ml/**/*.md
!sybil-attack/ml/**/*.sh
!sybil-attack/ml/**/*.txt
# Never track heavyweight artifacts / model weights / data / archive (order
# matters — these re-ignores come AFTER the source whitelist above).
sybil-attack/ml/.venv/
sybil-attack/ml/_archive/
sybil-attack/ml/**/adapters/
sybil-attack/ml/**/bakeoff/
sybil-attack/ml/**/context/
sybil-attack/ml/**/cache/
sybil-attack/ml/**/data/
sybil-attack/ml/**/data_*/
sybil-attack/ml/**/preds/
sybil-attack/ml/fusion/spine/
# (analyzers/**/outputs and fusion/outputs are already caught by the global
#  sybil-attack/**/outputs/** rule above.)

# Large regenerable dataset (239MB) — rebuild via
# notebooks/ml_models/rssi-analyzer/build_rssi_dataset.py. Never track.
sybil-attack/notebooks/ml_models/rssi-analyzer/rssi_dataset.csv
